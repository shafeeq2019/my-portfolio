// Prisma schema for the portfolio website.
// Production uses PostgreSQL; local dev can use SQLite by setting DATABASE_URL=file:./dev.db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl= env("DIRECT_URL")
}

/// Admin users who can log into the dashboard.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  role          Role      @default(ADMIN)
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

// --- Auth.js adapter models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Singleton profile / personal brand information.
model Profile {
  id            String   @id @default(cuid())
  fullName      String
  headline      String
  tagline       String?
  bio           String
  location      String?
  email         String
  phone         String?
  avatarUrl     String?
  resumeUrl     String?
  availableForWork Boolean @default(true)
  updatedAt     DateTime @updatedAt
  socialLinks   SocialLink[]
}

model SocialLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  icon      String  // key: github, linkedin, twitter, email, website, etc.
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String?
  employmentType String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String
  highlights  String?   // JSON-encoded string[] of bullet points
  logoUrl     String?
  companyUrl  String?
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  category    String   // e.g. "Web", "Mobile", "Open Source", "AI"
  technologies String  // JSON-encoded string[]
  liveUrl     String?
  repoUrl     String?
  outcome     String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  coverImage  String?
  images      ProjectImage[]
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   // "Languages", "Frameworks", "Tools", "Cloud", etc.
  level     Int      @default(3) // 1-5 proficiency
  icon      String?
  order     Int      @default(0)
  published Boolean  @default(true)
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  logoUrl     String?
  order       Int       @default(0)
  published   Boolean   @default(true)
}

model Certification {
  id          String    @id @default(cuid())
  name        String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  credentialId String?
  credentialUrl String?
  order       Int       @default(0)
  published   Boolean   @default(true)
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String?
  company   String?
  quote     String
  avatarUrl String?
  order     Int      @default(0)
  published Boolean  @default(false)
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}
