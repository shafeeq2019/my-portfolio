# ------------------------------------------------------------------
# Database
# Dev: SQLite (default). Prod: set a Postgres URL and change the
# provider in prisma/schema.prisma to "postgresql".
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# direct URL for Postgres connection 
DIRECT_URL=""

# ------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-strong-random-secret"
# Base URL of the deployed site (used for callbacks & metadata)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Seed admin credentials (used by `npm run db:seed`)
# ------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Site Admin"

# ------------------------------------------------------------------
# Email delivery (Resend) — optional in dev.
# If RESEND_API_KEY is unset, notifications are logged to the console.
# ------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL="you@example.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ------------------------------------------------------------------
# Spam protection — Cloudflare Turnstile (optional).
# Leave blank to disable the CAPTCHA (honeypot + rate-limit still apply).
# ------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ------------------------------------------------------------------
# Analytics (optional) — Plausible domain, leave blank to disable.
# ------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
